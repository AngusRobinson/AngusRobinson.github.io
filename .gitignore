# Track only the files served by the website.
*
!.gitignore
!index.html
!style.css
!grids/
grids/*
!grids/index.html
!grids/showcase/
grids/showcase/*
!grids/showcase/*.svg
!historical-decipherment/
historical-decipherment/*
!historical-decipherment/index.html
!historical-decipherment/labbe/
historical-decipherment/labbe/*
!historical-decipherment/labbe/*.html
!historical-decipherment/labbe/scans/
historical-decipherment/labbe/scans/*
!historical-decipherment/labbe/scans/*.jpg
!historical-decipherment/labbe/fragments/
historical-decipherment/labbe/fragments/*
!historical-decipherment/labbe/fragments/*.jpg
!historical-decipherment/labbe/fragments/*.png
